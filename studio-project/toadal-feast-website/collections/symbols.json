      "name": "DarkFeaturePanel",
      "type": "core.rich-text",
      "props": {
        "variant": "dark-feature-panel",
        "html": "<div class='home-section-inner'><div class='feast-pass-panel' data-companion-context='feast-pass' data-companion-copy='Feast Pass is planned for a later update; there are no live levels, rewards, or account sync here yet.' data-companion-reaction='proud'><div class='feast-pass-copy'><p class='section-kicker'>YOUR GUEST JOURNEY · PLANNED</p><h2 class='section-heading'>A Feast Pass built around your adventures</h2><p class='section-lede'>Feast Pass is planned for a later update. This preview does not show level, XP, Sparks, Treats, streaks, quests, or account sync as live player data.</p><div class='pass-signals' aria-label='Feast Pass status'><span class='pass-state'>Guest-first design</span><span class='pass-state'>Not live yet</span><span class='pass-state'>Account sync planned</span></div></div><div class='pass-emblem' aria-hidden='true'><span>FEAST</span><strong>PASS</strong><i>✦</i></div></div></div>"
