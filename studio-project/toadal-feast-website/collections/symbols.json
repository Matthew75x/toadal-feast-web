    {
      "id": "symbol.home.category-tabs",
      "name": "CategoryTabs",
      "type": "core.rich-text",
      "props": {
        "variant": "games-intro",
        "html": "<div class='home-section-inner' data-companion-context='browser-games' data-companion-copy='These cards are previews for browser adventures being prepared for the Feast.' data-companion-reaction='excited'><p class='section-kicker'>YOUR NEXT LITTLE ADVENTURE</p><h2 class='section-heading'>Browser game discovery</h2><p class='section-lede'>Four browser adventures are in preview. Wicked Bites and CLAW already have working preview builds behind the scenes, but this page does not launch them yet.</p><div class='game-tabs' role='group' aria-label='Filter browser game experiences'><button class='game-tab' type='button' aria-pressed='true' tabindex='0' aria-controls='browser-games browser-games-empty' data-game-tab='all'>All experiences <span>4</span></button><button class='game-tab' type='button' aria-pressed='false' tabindex='0' aria-controls='browser-games browser-games-empty' data-game-tab='preview'>Previews <span>4</span></button><button class='game-tab' type='button' aria-pressed='false' tabindex='0' aria-controls='browser-games browser-games-empty' data-game-tab='public'>Playable now <span>0</span></button></div><p id='browser-games-empty' class='game-empty' data-game-empty hidden role='status' aria-live='polite'>No browser game launches from this page yet. Playable previews will appear here only after their player experience is ready. The four preview cards remain visible in All and Previews.</p></div>"
      }
    },
    {
      "id": "symbol.home.toadal-companion",
      "name": "ToadalCompanion",
      "type": "core.rich-text",
      "props": {
        "variant": "companion",
        "html": "<aside class='toadal-companion' data-companion data-zone='hero' aria-label='Toadal contextual helper'><div class='companion-panel' id='toadal-companion-panel' data-companion-panel><p class='companion-label'>TOADAL’S FIELD NOTES</p><p class='companion-message' data-companion-speech aria-live='polite' aria-atomic='true'>Welcome to the Feast. I’ll point out what is ready to explore as you move through the page.</p></div><button class='companion-toggle' type='button' data-companion-toggle aria-controls='toadal-companion-panel' aria-expanded='true' aria-label='Minimize Toadal helper'><img class='companion-image' data-companion-image src='assets/images/characters/toadal-portrait.webp' alt='' width='256' height='256' loading='lazy' decoding='async'><span class='sr-only'>Minimize Toadal helper</span></button></aside>"
