ion'>\n  <div class='route-section__heading'><p class='section-kicker'>PLACES</p><h2 class='section-heading'>Wander somewhere wonderful</h2></div>\n  <div class='route-world-grid'>\n    <figure><img src='assets/images/world/candy-kingdom.webp' alt='Candy Kingdom' width='1424' height='750'><figcaption>Candy Kingdom</figcaption></figure>\n    <figure><img src='assets/images/world/candyland-calm.webp' alt='Candyland scenic world' width='1424' height='750'><figcaption>Candyland</figcaption></figure>\n    <figure><img src='assets/images/world/forest-portal.webp' alt='Forest portal' width='1424' height='750'><figcaption>Forest Portal</figcaption></figure>\n  </div>\n</section>"
