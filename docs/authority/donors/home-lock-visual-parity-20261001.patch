+    padding-block: 4px;
+    gap: clamp(16px, 2vw, 30px);
+  }
+  body:has(.home-hero) .site-brand {
+    font-size: clamp(1.25rem, 1.55vw, 1.55rem);
+    letter-spacing: -0.055em;
+  }
