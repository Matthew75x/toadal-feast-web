+    margin-block: 10px 12px;
+    line-height: 1.43;
+  }
+  body:has(.home-hero) .home-hero__toadal {
+    width: min(43vw, 535px);
+    transform: translate(-5%, 8%);
+  }
+  body:has(.home-hero) .home-hero__toadal img,
+  body:has(.home-hero) .home-hero__toadal > img {
+    max-height: 445px;
+  }
+  #browser-games-intro {
+    grid-column: 1;
+    grid-row: 2;
+    padding: 14px 0 4px;
+
+  }
+  #browser-games-intro .home-section-inner {
+    padding-inline: 14px 4px;
+  }
+  #browser-games-intro .section-heading {
+    margin-block: 2px 4px;
+    font-size: clamp(1.55rem, 2vw, 2.25rem);
+  }
+  #browser-games-intro .section-lede {
+    max-width: 760px;
+    margin-block: 0 8px;
+    font-size: .92rem;
+    line-height: 1.4;
+  }
+  #browser-games-intro .game-tabs {
+    margin-block: 5px 0;
+    gap: 6px;
+  }
+  #browser-games-intro .game-tab {
+    min-height: 34px;
+    padding: 5px 10px;
