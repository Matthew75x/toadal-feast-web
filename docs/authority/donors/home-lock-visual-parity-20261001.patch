+  }
+  #app {
+    grid-column: 1;
+    grid-row: 6;
+    padding: 0 0 16px 14px;
+  }
+  #app .app-conversion-panel {
+    min-height: 310px;
+    height: 100%;
+    padding: 22px;
+    color: var(--cream-50);
