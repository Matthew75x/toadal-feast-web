+    column-gap: 12px;
+    align-items: stretch;
+    background: var(--cream-100);
+  }
+  main:has(.home-hero) > .section,
+  main:has(.home-hero) > .studio-layout {
+    width: 100%;
+    min-width: 0;
+    margin-inline: 0;
+  }
+  main:has(.home-hero) > [data-studio-variant="accessibility-tools"] {
+    position: absolute;
+    width: auto;
+    padding: 0;
+  }
+  main:has(.home-hero) > #top {
+    grid-column: 1 / -1;
+    grid-row: 1;
+    padding-block: 0;
+  }
+  body:has(.home-hero) .home-hero,
+  body:has(.home-hero) .home-hero__layout {
+    min-height: 400px;
+    height: 400px;
+  }
+  body:has(.home-hero) .home-hero__layout {
+
+    grid-template-columns: minmax(410px, .85fr) minmax(480px, 1.15fr);
+    padding: 22px clamp(28px, 3.2vw, 52px) 16px;
+  }
+  body:has(.home-hero) .home-hero__copy {
+    max-width: 510px;
+  }
+  body:has(.home-hero) .home-hero__title {
+    font-size: clamp(3rem, 4.1vw, 4.05rem);
