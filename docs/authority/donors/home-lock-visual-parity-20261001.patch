+    padding: 6px 12px;
+    font-size: .78rem;
+  }
+
+  #browser-games {
+    grid-column: 1;
+    grid-row: 3;
+    padding: 4px 4px 14px 14px;
+    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
