+  }
+  #feast-pass .section-lede {
+    font-size: .86rem;
+    line-height: 1.4;
+  }
+  #feast-pass .pass-signals {
+    gap: 6px;
+    margin-block: 10px 12px;
+  }
+  #today {
+    grid-column: 1 / -1;
+    grid-row: 4;
+    padding: 0 14px 10px;
+  }
+
+  #today .today-panel {
+    padding: 10px 14px;
+    border-radius: 14px;
+    grid-template-columns: minmax(0, 1fr) auto;
+    align-items: center;
+  }
+  #today .section-heading {
+    margin-block: 2px;
+    font-size: 1.25rem;
+  }
+  #today .section-lede {
+    margin: 0;
+    font-size: .78rem;
+  }
+  #discovery {
+    grid-column: 1 / -1;
+    grid-row: 5;
+    padding: 0 14px 12px;
+  }
+  #discovery .discovery-heading {
+    display: grid;
+    grid-template-columns: auto minmax(360px, 1fr);
+    column-gap: 18px;
+    align-items: end;
+    margin-block-end: 8px;
+  }
+  #discovery .discovery-heading .section-kicker {
+    grid-column: 1 / -1;
+  }
+  #discovery .discovery-heading .section-heading {
+
+    margin: 0;
+    font-size: 1.7rem;
+  }
+  #discovery .discovery-heading .section-lede {
+    margin: 0;
+    font-size: .82rem;
+  }
