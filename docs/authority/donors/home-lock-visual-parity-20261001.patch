+    padding: 14px;
+    border: 1px solid rgb(166 102 6 / 24%);
+    border-radius: 16px;
+    background: #fffaf0;
+  }
+  #whats-next .section-heading {
+    margin-block: 2px 5px;
+    font-size: 1.35rem;
+  }
+  #whats-next .section-lede {
+    margin-block: 0 8px;
+    font-size: .76rem;
+    line-height: 1.35;
+  }
+  #whats-next .whats-next-grid {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 7px;
+  }
+
+  #whats-next .next-card {
+    min-height: 0;
+    padding: 8px;
+    border-radius: 11px;
+  }
+  #whats-next .next-card h3 {
+    margin-block: 4px 3px;
+    font-size: .84rem;
+  }
+  #whats-next .next-card p {
