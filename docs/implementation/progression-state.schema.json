{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toadalfeast.com/schemas/progression-state-v1.json",
  "title": "TOADAL FEAST Web Guest Progression State",
  "type": "object",
  "required": [
    "schemaVersion",
    "updatedAt",
    "level",
    "xp",
    "sparks",
    "treats",
    "streak"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "level": {
      "type": "integer",
      "minimum": 1
    },
    "xp": {
      "type": "integer",
      "minimum": 0
    },
    "sparks": {
      "type": "integer",
      "minimum": 0
    },
    "treats": {
      "type": "integer",
      "minimum": 0
    },
    "streak": {
      "type": "object",
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "lastQualifiedPeriod": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "badges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "discoveries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "collectibles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "quests": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "progress": {
            "type": "number",
            "minimum": 0
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "claimedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "localScores": {
      "$ref": "#/$defs/localScores"
    },
    "profile": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectedBadge": {
          "type": [
            "string",
            "null"
          ]
        },
        "localScores": {
          "$ref": "#/$defs/localScores"
        }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "localScores": {
      "type": "object",
      "maxProperties": 24,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/localScoreGame"
      }
    },
    "localScoreGame": {
      "type": "object",
      "required": [
        "best",
        "runs"
      ],
      "properties": {
        "best": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/localScoreRun"
          }
        }
      },
      "additionalProperties": false
    },
    "localScoreRun": {
      "type": "object",
      "required": [
        "score",
        "completedAt",
        "mode",
        "ruleset",
        "characterId",
        "completionId"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "ruleset": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "characterId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "completionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "additionalProperties": false
    }
  }
}
