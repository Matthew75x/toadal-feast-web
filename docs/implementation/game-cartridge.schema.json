{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toadalfeast.com/schemas/game-cartridge-v1.json",
  "title": "TOADAL FEAST Browser Game Cartridge",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "version",
    "publicState",
    "entry",
    "orientation",
    "inputs",
    "storage",
    "protocol",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "publicState": {
      "enum": [
        "PUBLIC",
        "PREVIEW",
        "PLANNED",
        "COMING_SOON",
        "DISABLED"
      ]
    },
    "entry": {
      "type": "string",
      "pattern": "^[^/].*\\.html$"
    },
    "poster": {
      "type": [
        "string",
        "null"
      ]
    },
    "orientation": {
      "enum": [
        "any",
        "portrait",
        "landscape",
        "landscape-preferred",
        "portrait-preferred"
      ]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "touch": {
          "type": "boolean"
        },
        "keyboard": {
          "type": "boolean"
        },
        "mouse": {
          "type": "boolean"
        },
        "gamepad": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": [
        "namespace",
        "persistence"
      ],
      "properties": {
        "namespace": {
          "type": "string"
        },
        "persistence": {
          "enum": [
            "none",
            "session",
            "local"
          ]
        },
        "accountSync": {
          "enum": [
            "none",
            "planned",
            "supported"
          ]
        }
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "toadal.game"
        },
        "version": {
          "const": 1
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "ref",
        "entrySource"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "entrySource": {
          "type": "string"
        },
        "sourceHash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "knownLimitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "package": {
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "additionalProperties": true
}