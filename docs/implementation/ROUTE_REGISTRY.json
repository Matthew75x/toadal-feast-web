      "path": "/news/",
      "template": "editorial-index",
      "phase": "WO-006",
      "state": "PUBLIC_WHEN_IMPLEMENTED"
    },
    {
      "n": 13,
      "id": "devlog",
      "path": "/news/:slug/",
      "template": "editorial-detail",
      "phase": "WO-006",
      "state": "PUBLIC_PER_REAL_CONTENT"
    },
    {
      "n": 14,
      "id": "feast-pass",
      "path": "/feast-pass/",
      "template": "progression",
      "phase": "WO-005",
      "state": "PUBLIC_GUEST_LOCAL"
    },
    {
      "n": 15,
      "id": "quests",
      "path": "/feast-pass/quests/",
      "template": "progression",
      "phase": "WO-005",
      "state": "PUBLIC_GUEST_LOCAL"
