      "path": "/characters/toadal/",
      "template": "entity-detail",
      "phase": "WO-003",
      "state": "PUBLIC_WHEN_IMPLEMENTED"
    },
    {
      "n": 8,
      "id": "stories",
      "path": "/stories/",
      "template": "hub",
      "phase": "WO-004",
      "state": "PUBLIC_WHEN_IMPLEMENTED"
    },
    {
      "n": 9,
      "id": "manga-series",
      "path": "/stories/:seriesId/",
      "template": "entity-detail",
      "phase": "WO-004",
      "state": "PUBLIC_PER_REAL_CONTENT"
    },
    {
      "n": 10,
      "id": "comic-reader",
      "path": "/stories/:seriesId/:chapterId/read/",
      "template": "focused-runtime",
      "phase": "WO-004",
      "state": "PUBLIC_PER_REAL_CONTENT"
