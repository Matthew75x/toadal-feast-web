      "template": "progression",
      "phase": "WO-005",
      "state": "LOCAL_PUBLIC_GLOBAL_PLANNED"
    },
    {
      "n": 18,
      "id": "app",
      "path": "/app/",
      "template": "conversion",
      "phase": "WO-006",
      "state": "PUBLIC_INFORMATIONAL"
    },
    {
      "n": 19,
      "id": "account",
      "path": "/account/",
      "template": "account",
      "phase": "WO-006",
      "state": "PREVIEW_UNTIL_BACKEND"
    },
    {
      "n": 20,
      "id": "profile",
      "path": "/profile/",
      "template": "progression",
      "phase": "WO-005",
      "state": "GUEST_LOCAL_PUBLIC_REGISTERED_PLANNED"
    },
    {
      "n": 21,
      "id": "community",
      "path": "/community/",
      "template": "hub",
      "phase": "WO-006",
      "state": "COMING_SOON"
    },
    {
      "n": 22,
      "id": "store",
      "path": "/store/",
      "template": "hub",
      "phase": "WO-006",
      "state": "COMING_SOON_NO_CHECKOUT"
    },
    {
      "n": 23,
      "id": "search",
      "path": "/search/",
      "template": "utility",
      "phase": "WO-006",
      "state": "PUBLIC_LOCAL_SEARCH"
    },
    {
      "n": 24,
      "id": "roadmap",
      "path": "/roadmap/",
      "template": "editorial-index",
      "phase": "WO-006",
      "state": "PUBLIC_APPROVED_ITEMS_ONLY"
    },
    {
      "n": 25,
      "id": "support",
      "path": "/support/",
      "template": "utility",
      "phase": "WO-006",
      "state": "PUBLIC_WHEN_IMPLEMENTED"
    },
    {
      "n": 26,
      "id": "contact",
      "path": "/contact/",
      "template": "utility",
      "phase": "WO-006",
      "state": "PUBLIC_ROUTING_FORM_PER_REAL_ENDPOINT"
    },
    {
      "n": 27,
      "id": "about",
      "path": "/about/",
      "template": "utility",
      "phase": "WO-006",
      "state": "PUBLIC_WHEN_IMPLEMENTED"
    },
    {
      "n": 28,
      "id": "coming-soon",
      "path": "/coming-soon/",
      "template": "system",
      "phase": "WO-006",
      "state": "PUBLIC_REUSABLE"
    },
    {
      "n": 29,
      "id": "legal",
      "path": "/legal/",
      "template": "system",
      "phase": "WO-006",
      "state": "PUBLIC_APPROVED_COPY_ONLY"
    },
    {
      "n": 30,
      "id": "not-found",
      "path": "*",
      "output": "404.html",
      "template": "system",
      "phase": "WO-006",
      "state": "PUBLIC_WHEN_IMPLEMENTED"
    }
