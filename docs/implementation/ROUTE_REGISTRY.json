{
  "schema": "toadal-feast.web.routes.v1",
  "basePathPolicy": "base-path-aware-static-export",
  "githubPagesProjectPath": "/toadal-feast-web/",
  "routes": [
    {
      "n": 1,
      "id": "home",
      "path": "/",
      "template": "hub",
      "phase": "WO-001",
      "state": "PUBLIC_WHEN_IMPLEMENTED"
    },
    {
      "n": 2,
      "id": "play",
      "path": "/play/",
      "template": "hub",
      "phase": "WO-002",
      "state": "PUBLIC_WHEN_IMPLEMENTED"
    },
    {
      "n": 3,
      "id": "wicked-bites",
      "path": "/play/wicked-bites/",
      "template": "entity-detail",
      "phase": "WO-002",
      "state": "PREVIEW_UNTIL_REAL_BUILD"
    },
    {
      "n": 4,
      "id": "game-player",
      "path": "/play/:gameId/player/",
      "template": "focused-runtime",
      "phase": "WO-002",
      "state": "PUBLIC_PER_CARTRIDGE"
    },
    {
      "n": 5,
      "id": "world",
      "path": "/world/",
      "template": "hub",
      "phase": "WO-003",
      "state": "PUBLIC_WHEN_IMPLEMENTED"
    },
    {
      "n": 6,
      "id": "characters",
      "path": "/characters/",
      "template": "hub",
      "phase": "WO-003",
      "state": "PUBLIC_WHEN_IMPLEMENTED"
    },
    {
      "n": 7,
