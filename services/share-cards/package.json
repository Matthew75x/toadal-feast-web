{
  "name": "@toadal/share-cards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/local-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "types": "wrangler types --include-runtime false",
    "build:worker": "wrangler deploy --dry-run --outdir build",
    "verify:assets": "node scripts/verify-assets.mjs",
    "test:browser": "node scripts/qualify-composer-browser.mjs",
    "test:worker": "node scripts/worker-smoke.mjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "typescript": "7.0.2",
    "wrangler": "4.148.0",
    "playwright": "1.62.1"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
